# NFL repo hygiene
*.bak_*
scripts/_scratch/
proofs/_tmp/

# archived cruft pending manual deletion
_to_delete/

# high-churn runtime telemetry (kept on disk, not version-controlled)
proofs/receipts/nfl_ingest_runs.ndjson
runtime/ingest/last_run.json

# durable-ledger runtime outputs (kept on disk, not version-controlled)
proofs/runs/
proofs/checkpoints/
proofs/receipts/nfl.ledger.verify.ndjson
proofs/receipts/nfl.ledger.selftest.ndjson

# portable export bundles (on-disk runtime)
proofs/exports/

# rotated telemetry archives
proofs/receipts/archive/

# ledger write-lock + chain-verify telemetry
data/*.lock
proofs/receipts/nfl.ledger.chain_verify.ndjson

# SECRETS: never version private keys
proofs/keys/id_ed25519
proofs/keys/*.key
*.pem
runtime/scheduler/

# lock files next to receipts
proofs/receipts/**/*.lock
proofs/receipts/*.lock

# operator drop folders and derived manifests (runtime)
inbox/
runtime/manifests/
